// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model App {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?  // URL icon/logo of the app
  category    String?  // Social, Finance, Productivity, E-commerce, etc.
  platform    Platform @default(IOS)
  brandColor  String?  // Main brand color of the app (hex code)
  websiteUrl  String?
  slug        String   @unique // URL-friendly name: instagram, spotify, etc.
  
  // Relations
  screens     Screen[]
  appTypes    AppType[]  // Many-to-many relation with Type
  
  // Metadata
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([platform])
  @@index([slug])
  @@index([name])
}

model Screen {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String   // Screenshot image URL
  
  // Relations
  appId       String
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  
  // Categorization
  screenType  String?  // Login, Home, Profile, Settings, Onboarding, Checkout, etc.
  tags        String[] // modal, form, list, card, navigation, animation, etc.
  
  // Engagement
  viewCount   Int      @default(0)
  likeCount   Int      @default(0)
  
  // Metadata
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([appId])
  @@index([screenType])
  @@index([viewCount])
  @@index([likeCount])
}

model Type {
  id          String    @id @default(cuid())
  name        String    @unique  // Transportation, Finance, Entertainment, Lifestyle, Productivity
  slug        String    @unique
  description String?
  icon        String?
  
  // Relations
  apps        AppType[]
  
  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model AppType {
  id        String   @id @default(cuid())
  
  // Relations
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  
  typeId    String
  type      Type     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([appId, typeId])
  @@index([appId])
  @@index([typeId])
}

enum Platform {
  IOS
  ANDROID
  WEB
}

// NextAuth.js Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  transactions  Transaction[]
  orders        Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Order {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  total         Decimal  @db.Decimal(20, 2) // Số tiền (VNĐ)
  paymentStatus String   @default("Unpaid") // "Unpaid" | "Paid"
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([paymentStatus])
}

model Transaction {
  id                 String    @id @default(cuid())
  
  // User reference
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Transaction details từ SePay webhook
  gateway            String    @db.VarChar(100)
  transactionDate    DateTime  @default(now())
  accountNumber      String?   @db.VarChar(100)
  subAccount         String?   @db.VarChar(250)
  
  // Amounts
  amountIn           Decimal   @default(0.00) @db.Decimal(20, 2)
  amountOut          Decimal   @default(0.00) @db.Decimal(20, 2)
  accumulated        Decimal   @default(0.00) @db.Decimal(20, 2)
  
  // Additional info
  code               String?   @db.VarChar(250)
  transactionContent String?   @db.Text
  referenceNumber    String?   @db.VarChar(255)
  body               String?   @db.Text
  
  // Metadata
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([transactionDate])
  @@index([gateway])
  @@index([transactionContent])
}